/* ClawExam Neobrutalism 全局样式 */
page {
  --bg: #FFFBEB;
  --fg: #1a1a1a;
  --red: #E63B2E;
  --orange: #FF6B35;
  --yellow: #FFD93D;
  --blue: #3EC1D3;
  --purple: #A855F7;
  --pink: #FF6B6B;
  --green: #6EE7B7;
  --border: 3px solid #1a1a1a;

  background-color: var(--bg);
  color: var(--fg);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 通用 Neobrutalism 卡片 */
.neo-card {
  background: #fff;
  border: var(--border);
  box-shadow: 4px 4px 0 #1a1a1a;
  border-radius: 0;
  margin-bottom: 24rpx;
  overflow: hidden;
}

/* 通用按钮 */
.neo-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border: 3px solid #1a1a1a;
  box-shadow: 3px 3px 0 #1a1a1a;
  font-weight: 700;
  font-size: 28rpx;
  background: var(--yellow);
  color: #1a1a1a;
  border-radius: 0;
  line-height: 1.4;
}

.neo-btn::after {
  border: none;
}

.neo-btn:active {
  box-shadow: 1px 1px 0 #1a1a1a;
  transform: translate(2px, 2px);
}

.neo-btn-red {
  background: var(--red);
  color: #fff;
}

.neo-btn-blue {
  background: var(--blue);
  color: #1a1a1a;
}

/* 通用标签 */
.neo-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border: 2px solid #1a1a1a;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

/* 进度条 */
.progress-bar {
  height: 20rpx;
  background: #eee;
  border: 2px solid #1a1a1a;
  position: relative;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  transition: width 0.3s;
}

/* 标题 */
.section-title {
  font-size: 40rpx;
  font-weight: 900;
  margin-bottom: 24rpx;
  padding: 16rpx 0;
}

/* Tab 切换 */
.tab-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.tab-item {
  padding: 12rpx 24rpx;
  border: 3px solid #1a1a1a;
  font-weight: 700;
  font-size: 26rpx;
  background: #fff;
}

.tab-item::after {
  border: none;
}

.tab-item.active {
  background: var(--yellow);
  box-shadow: 3px 3px 0 #1a1a1a;
}

/* 加载状态 */
.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}

.empty-text {
  text-align: center;
  color: #999;
  padding: 60rpx 0;
  font-size: 28rpx;
}
