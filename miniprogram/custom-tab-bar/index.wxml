<view class="tab-bar-wrap">
  <view class="tab-bar">
    <view
      wx:for="{{list}}"
      wx:key="index"
      class="tab-item {{selected === index ? 'active' : ''}}"
      data-path="{{item.pagePath}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <image class="tab-icon" src="{{selected === index ? item.iconActive : item.iconNormal}}" mode="aspectFit" />
      <text class="tab-text">{{item.text}}</text>
      <view wx:if="{{selected === index}}" class="tab-dot"></view>
    </view>
  </view>
</view>
