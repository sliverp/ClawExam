/* Neobrutalism TabBar · 轻量毛玻璃版 */
.tab-bar-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
  padding: 0 20rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: transparent;
}

.tab-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 110rpx;
  background: rgba(255, 251, 235, 0.82);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 3px solid #1a1a1a;
  border-bottom: none;
  border-radius: 28rpx 28rpx 0 0;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  position: relative;
  transition: all 0.15s ease;
}

.tab-item + .tab-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 2rpx;
  height: 48rpx;
  background: rgba(26, 26, 26, 0.15);
  border-radius: 2rpx;
}

.tab-icon {
  font-size: 44rpx;
  margin-bottom: 4rpx;
  line-height: 1.2;
}

.tab-text {
  font-size: 20rpx;
  font-weight: 800;
  color: #999;
  letter-spacing: 1rpx;
}

.tab-item.active .tab-text {
  color: #1a1a1a;
}

.tab-dot {
  position: absolute;
  bottom: 14rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #E63B2E;
}
