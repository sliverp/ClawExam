/* Neobrutalism TabBar · 爆款版 */
.tab-bar-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
  padding: 0 20rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFBEB;
}

.tab-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 120rpx;
  background: #1a1a1a;
  border: 3px solid #1a1a1a;
  border-radius: 28rpx 28rpx 0 0;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  position: relative;
  transition: all 0.15s ease;
}

.tab-icon {
  font-size: 44rpx;
  margin-bottom: 4rpx;
  line-height: 1.2;
}

.tab-text {
  font-size: 20rpx;
  font-weight: 800;
  color: #888;
  letter-spacing: 1rpx;
}

.tab-item.active .tab-text {
  color: #FFD93D;
}

.tab-dot {
  position: absolute;
  bottom: 14rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #FFD93D;
}
