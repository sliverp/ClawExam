/* ============================================
   隐私政策页面 · Neobrutalism 风格
   ============================================ */
.privacy-page {
  height: 100vh;
  background: #FFFBEB;
}

.privacy-container {
  padding: 40rpx 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.privacy-header {
  text-align: center;
  margin-bottom: 48rpx;
  padding-bottom: 32rpx;
  border-bottom: 3px solid #1a1a1a;
}

.privacy-title {
  display: block;
  font-size: 48rpx;
  font-weight: 900;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.privacy-date {
  display: block;
  font-size: 24rpx;
  color: #888;
  font-weight: 600;
}

.privacy-section {
  margin-bottom: 40rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  padding: 12rpx 20rpx;
  background: #FFD93D;
  border: 3px solid #1a1a1a;
  box-shadow: 3px 3px 0 #1a1a1a;
  border-radius: 8rpx;
}

.subsection-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #1a1a1a;
  margin-top: 24rpx;
  margin-bottom: 12rpx;
}

.section-text {
  display: block;
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 12rpx;
}

.bold {
  font-weight: 800;
  color: #1a1a1a;
}

.privacy-footer {
  text-align: center;
  padding-top: 40rpx;
  margin-top: 40rpx;
  border-top: 3px solid #1a1a1a;
}

.footer-text {
  font-size: 24rpx;
  color: #888;
  font-weight: 600;
}
