.page {
  padding-bottom: 18rpx;
}

.arena-detail-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1b1b1b 0%, #1b1b1b 228rpx, #fff8e8 228rpx, #fff8e8 100%);
}

.arena-detail-layout {
  min-height: 100vh;
  background: linear-gradient(180deg, #1b1b1b 0%, #1b1b1b 228rpx, #fff8e8 228rpx, #fff8e8 100%);
}

.arena-detail-hero {
  padding: 34rpx 32rpx 22rpx;
  background: #1b1b1b;
}

.arena-detail-title {
  display: block;
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 900;
  color: #fff;
}

.arena-detail-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 94rpx;
  height: 54rpx;
  padding: 0 20rpx;
  margin-top: 18rpx;
  border-radius: 18rpx;
  background: #ffc831;
  color: #1a140d;
  font-size: 20rpx;
  font-weight: 900;
}

.arena-detail-panel {
  margin: 12rpx 18rpx 0;
  padding: 30rpx 18rpx 20rpx;
  border-radius: 34rpx;
  background: linear-gradient(180deg, #fff7c7 0%, #fffdf6 100%);
  box-shadow: 0 14rpx 28rpx rgba(183, 146, 32, 0.12);
}

.arena-detail-panel-head {
  margin-bottom: 24rpx;
}

.arena-detail-panel-title {
  position: relative;
  display: inline-block;
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 900;
  color: #18130d;
}

.arena-detail-panel-title::after {
  content: '';
  position: absolute;
  left: 0;
  right: -8rpx;
  bottom: 0;
  height: 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(111, 224, 217, 0.76) 0%, rgba(255, 231, 125, 0.82) 48%, rgba(255, 175, 126, 0.76) 100%);
  z-index: -1;
}

.arena-detail-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.arena-detail-player {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 22rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 10rpx 22rpx rgba(222, 207, 160, 0.24);
}

.arena-detail-rank {
  width: 34rpx;
  flex-shrink: 0;
  text-align: center;
  font-size: 40rpx;
  line-height: 1;
  font-weight: 300;
  color: #c7b38c;
}

.arena-detail-avatar {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f2f2f2;
}

.arena-detail-main {
  flex: 1;
  min-width: 0;
}

.arena-detail-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.arena-detail-name {
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.25;
  font-weight: 800;
  color: #544c45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arena-detail-me {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 12rpx;
  background: #ffe9b5;
  color: #ff8d12;
  font-size: 18rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.arena-detail-waiting {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #b7b1aa;
}

.arena-detail-finished {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #ff5b4b;
  font-weight: 900;
}

.arena-detail-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 26rpx;
}

.arena-detail-btn {
  height: 80rpx;
  min-width: 0;
  padding: 0 16rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.arena-detail-btn::after {
  border: none;
}

.arena-detail-btn-primary {
  border: none;
  background: #000;
  color: #fff;
}

.arena-detail-btn-secondary {
  border: 2rpx solid #1c1610;
  background: #fffdf6;
  color: #1c1610;
}

.loading-wrap {
  padding: 120rpx 0 80rpx;
  text-align: center;
}

.loading-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.55);
}

.arena-detail-empty {
  min-height: 100vh;
  padding: 120rpx 48rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: #000;
}

.arena-detail-empty-icon {
  font-size: 88rpx;
}

.arena-detail-empty-title {
  margin-top: 22rpx;
  font-size: 38rpx;
  font-weight: 900;
  color: #fff;
}

.arena-detail-back-btn {
  margin-top: 28rpx;
  width: 280rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 24rpx;
  border: none;
  background: #fff;
  color: #111;
  font-size: 28rpx;
  font-weight: 800;
}

.arena-detail-back-btn::after {
  border: none;
}
