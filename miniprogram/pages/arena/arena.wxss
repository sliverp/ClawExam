.page {
  padding: 24rpx;
}

.arena-info {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.arena-title-row {
  margin-bottom: 12rpx;
}

.arena-title {
  font-size: 36rpx;
  font-weight: 900;
}

.arena-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.arena-code {
  font-size: 26rpx;
  font-weight: 700;
  color: #666;
  letter-spacing: 2rpx;
}

.arena-creator {
  font-size: 24rpx;
  color: #888;
}

.lb-list {
  margin-bottom: 24rpx;
}

.lb-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  margin-bottom: 12rpx;
}

.lb-item.is-me {
  background: #FFF9E0;
  border-color: #E63B2E;
}

.lb-rank {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid #1a1a1a;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.lb-rank-num {
  font-size: 26rpx;
  font-weight: 900;
}

.lb-avatar-wrap {
  margin-right: 12rpx;
  flex-shrink: 0;
}

.lb-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2px solid #1a1a1a;
}

.lb-info {
  flex: 1;
  min-width: 0;
}

.lb-name {
  font-size: 28rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 4rpx;
}

.lb-score {
  font-size: 28rpx;
  font-weight: 700;
  color: #E63B2E;
}

.lb-detail {
  font-size: 22rpx;
  color: #888;
  display: block;
  margin-top: 4rpx;
}

.lb-waiting {
  font-size: 24rpx;
  color: #ccc;
  font-style: italic;
}

.action-area {
  margin-top: 32rpx;
  margin-bottom: 40rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  font-size: 30rpx;
  margin-bottom: 16rpx;
}

.action-hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: -8rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  text-align: center;
  color: #999;
  padding: 60rpx 0;
}
