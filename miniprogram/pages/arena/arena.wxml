<view class="page arena-detail-page">
  <view class="loading-wrap" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:if="{{!loading && error}}" class="arena-detail-empty">
    <text class="arena-detail-empty-icon">😵</text>
    <text class="arena-detail-empty-title">{{error}}</text>
    <button class="arena-detail-back-btn" bindtap="onGoBack">返回竞技场列表</button>
  </view>

  <view wx:if="{{!loading && arena}}" class="arena-detail-layout">
    <view class="arena-detail-hero">
      <text class="arena-detail-title">{{arena.exam_name}}</text>
      <text class="arena-detail-status">{{arena.statusText}}</text>
    </view>

    <view class="arena-detail-panel">
      <view class="arena-detail-panel-head">
        <text class="arena-detail-panel-title">参赛选手</text>
      </view>

      <view class="arena-detail-list">
        <view class="arena-detail-player" wx:for="{{participants}}" wx:key="uid_hash">
          <text class="arena-detail-rank">{{item.rank}}</text>
          <image class="arena-detail-avatar" src="{{item.avatar_url || '/images/default-avatar.png'}}" mode="aspectFill" />

          <view class="arena-detail-main">
            <view class="arena-detail-name-row">
              <text class="arena-detail-name">{{item.nickname}}</text>
              <text wx:if="{{item.is_me}}" class="arena-detail-me">我</text>
            </view>
            <text wx:if="{{item.status === 'finished'}}" class="arena-detail-finished">{{item.scoreText}}</text>
            <text wx:else class="arena-detail-waiting">等待中...</text>
          </view>
        </view>
      </view>

      <view class="arena-detail-actions">
        <button
          wx:if="{{joined}}"
          class="arena-detail-btn arena-detail-btn-primary"
          bindtap="onCopyCommand"
        >
          复制我的考试指令
        </button>

        <button
          wx:if="{{!joined && isLoggedIn}}"
          class="arena-detail-btn arena-detail-btn-primary"
          bindtap="onJoin"
        >
          加入竞技场
        </button>

        <button
          wx:if="{{!isLoggedIn}}"
          class="arena-detail-btn arena-detail-btn-primary"
          bindtap="onJoin"
        >
          登录并加入
        </button>

        <button class="arena-detail-btn arena-detail-btn-secondary" open-type="share">
          邀请好友来PK
        </button>
      </view>
    </view>
  </view>

  <login-popup show="{{showLoginPopup}}" bind:close="onLoginClose" bind:success="onLoginSuccess" />
</view>
