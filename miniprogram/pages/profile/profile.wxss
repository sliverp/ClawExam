.profile-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 16% 8%, rgba(255, 170, 91, 0.34) 0, rgba(255, 170, 91, 0) 24%),
    radial-gradient(circle at 82% 18%, rgba(255, 247, 168, 0.55) 0, rgba(255, 247, 168, 0) 28%),
    linear-gradient(180deg, #ffd96a 0%, #ffd861 48%, #f9cc5c 100%);
  padding: 28rpx 0 20rpx;
}

.profile-content {
  padding-bottom: 36rpx;
}

.profile-empty {
  min-height: calc(100vh - 220rpx);
  padding: 80rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.profile-empty-icon {
  font-size: 88rpx;
  margin-bottom: 18rpx;
}

.profile-empty-title {
  font-size: 42rpx;
  font-weight: 900;
  color: #1f1d1c;
}

.profile-empty-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: rgba(70, 62, 54, 0.62);
}

.profile-login-btn {
  margin-top: 32rpx;
  width: 280rpx;
  height: 88rpx;
  border-radius: 24rpx;
  border: none;
  background: linear-gradient(90deg, #ff6f62 0%, #ffc83f 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
}

.profile-login-btn::after {
  border: none;
}

.profile-user-card,
.profile-section {
  margin: 0 28rpx 28rpx;
}

.profile-user-card {
  padding: 30rpx 28rpx;
  border-radius: 30rpx;
  background: #1c1c1c;
  display: flex;
  align-items: center;
  box-shadow: 0 14rpx 24rpx rgba(115, 88, 31, 0.12);
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 22rpx;
  background: #fff;
}

.profile-user-main {
  flex: 1;
  min-width: 0;
}

.profile-name {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-user-meta {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.profile-user-meta-text,
.profile-user-meta-dot {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.54);
}

.profile-user-badge {
  margin-left: 16rpx;
  font-size: 34rpx;
}

.profile-section {
  padding: 24rpx 0 0;
  border-radius: 34rpx;
  background: linear-gradient(180deg, rgba(255, 248, 210, 0.94) 0%, rgba(255, 247, 210, 0.78) 100%);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.4), 0 14rpx 24rpx rgba(115, 88, 31, 0.08);
}

.profile-score-section {
  padding-top: 0;
  background: transparent;
  box-shadow: none;
}

.profile-section-inner {
  margin: 0 24rpx 24rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 24rpx rgba(115, 88, 31, 0.08);
}

.score-card-main {
  text-align: center;
}

.score-card-label {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #8c94a4;
}

.score-card-percent {
  display: block;
  margin-top: 20rpx;
  font-size: 112rpx;
  line-height: 1;
  font-weight: 900;
  color: #ff9800;
}

.score-card-grade {
  display: block;
  margin-top: 14rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #ff9800;
}

.score-card-beat {
  margin-top: 28rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.score-card-beat-text {
  font-size: 26rpx;
  color: #36312b;
}

.score-card-beat-highlight {
  font-size: 38rpx;
  font-weight: 900;
  color: #ff483e;
}

.score-card-fire {
  font-size: 34rpx;
}

.score-card-tip {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #b1b7c4;
}

.score-card-share-btn {
  margin-top: 34rpx;
  width: 100%;
  height: 84rpx;
  border: none;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #ff7474 0%, #ffc63f 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
}

.score-card-share-btn::after {
  border: none;
}

.score-card-empty-main {
  padding-top: 40rpx;
  padding-bottom: 40rpx;
}

.score-card-empty-title {
  display: block;
  margin-top: 18rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #2c2926;
}

.profile-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 0 26rpx 20rpx;
}

.profile-section-title-wrap {
  position: relative;
}

.profile-section-title-wrap::before {
  content: '';
  position: absolute;
  left: 0;
  bottom: 6rpx;
  width: 100%;
  height: 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(135, 232, 218, 0.9) 0%, rgba(255, 226, 124, 0.9) 52%, rgba(255, 167, 136, 0.85) 100%);
  opacity: 0.95;
}

.profile-section-title {
  position: relative;
  z-index: 1;
  font-size: 42rpx;
  font-weight: 900;
  color: #1f1d1c;
}

.profile-section-desc {
  font-size: 22rpx;
  color: rgba(130, 116, 82, 0.84);
  white-space: nowrap;
}

.exam-summary-list,
.history-card-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin: 0 24rpx 24rpx;
}

.exam-summary-card,
.history-card,
.profile-action-card {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  overflow: hidden;
  box-shadow: 0 10rpx 20rpx rgba(115, 88, 31, 0.07);
}

.exam-summary-card-head {
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.exam-summary-name {
  font-size: 26rpx;
  font-weight: 800;
  color: #20201f;
}

.exam-summary-version,
.history-card-tag {
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  font-size: 18rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.8);
  color: rgba(45, 45, 45, 0.62);
}

.exam-summary-card-body {
  padding: 22rpx 24rpx 26rpx;
}

.exam-summary-score {
  display: block;
  font-size: 62rpx;
  line-height: 1;
  font-weight: 900;
}

.exam-summary-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.exam-summary-meta-text,
.exam-summary-meta-dot,
.exam-summary-duration {
  font-size: 22rpx;
  color: #9ea3ab;
}

.exam-summary-duration {
  display: block;
  margin-top: 12rpx;
}

.exam-summary-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 122rpx;
}

.exam-summary-empty-text {
  font-size: 34rpx;
  color: #d0d0d0;
}

.history-card {
  padding: 26rpx 24rpx;
}

.history-empty-card {
  min-height: 140rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 20rpx rgba(115, 88, 31, 0.07);
}

.history-empty-text {
  font-size: 28rpx;
  color: #c0c4ce;
}

.history-card-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.history-card-left {
  flex: 1;
  min-width: 0;
}

.history-card-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.history-card-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #22201e;
}

.grade-tag {
  color: #ff7b56;
  background: #ffe5dd;
}

.history-card-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7b8290;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-card-time {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9ea3ab;
}

.history-card-score {
  flex-shrink: 0;
  font-size: 54rpx;
  font-weight: 900;
  color: #ff9726;
}

.profile-action-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
}

.profile-action-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.profile-action-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #ffd56c 0%, #ffc850 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.profile-action-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #23211f;
}

.profile-action-arrow {
  font-size: 42rpx;
  color: #a3a9b6;
  line-height: 1;
}

.share-guide-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 998;
  background: rgba(0, 0, 0, 0.34);
}

.share-guide-modal {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(132rpx + env(safe-area-inset-bottom));
  z-index: 999;
  padding: 34rpx 28rpx 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 18rpx 36rpx rgba(0, 0, 0, 0.16);
}

.share-guide-title {
  display: block;
  font-size: 38rpx;
  font-weight: 900;
  color: #25211d;
}

.share-guide-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: rgba(78, 71, 64, 0.74);
}

.share-guide-primary {
  margin-top: 24rpx;
  width: 100%;
  height: 82rpx;
  border: none;
  border-radius: 22rpx;
  background: linear-gradient(90deg, #ff7371 0%, #ffbf3c 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
}

.share-guide-primary::after {
  border: none;
}

.share-guide-tip-box {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: #fff7df;
}

.share-guide-tip-title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #68553c;
}

.share-guide-tip-text {
  display: block;
  font-size: 23rpx;
  line-height: 1.65;
  color: #7e705d;
}

.share-guide-close {
  margin-top: 20rpx;
  text-align: center;
  font-size: 25rpx;
  font-weight: 700;
  color: #8e97a6;
}
