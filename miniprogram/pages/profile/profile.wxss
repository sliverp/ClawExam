/* ============================================
   个人中心 · Neobrutalism 爆款版
   ============================================ */
.page {
  padding-bottom: 40rpx;
}

/* ---- Profile Hero ---- */
.profile-hero {
  padding: 32rpx 32rpx 0;
}

.profile-card {
  background: var(--fg);
  box-shadow: var(--shadow-lg);
}

.profile-card-inner {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  gap: 28rpx;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4px solid var(--yellow);
  box-shadow: var(--shadow);
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 900;
  display: block;
  margin-bottom: 4rpx;
  color: var(--white);
}

.profile-uid {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 16rpx;
}

.profile-stats-row {
  display: flex;
  gap: 32rpx;
}

.profile-stat {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.profile-stat-num {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--yellow);
}

.profile-stat-label {
  font-size: 22rpx;
  color: #999;
  font-weight: 600;
}

/* ============================================
   分享成绩卡片 - 社交货币
   ============================================ */
.share-section {
  padding-bottom: 0;
}

.share-card-preview {
  background: linear-gradient(135deg, var(--fg) 0%, #2a2a2a 100%);
  border: var(--border-thick);
  border-radius: var(--radius);
  box-shadow: var(--shadow-lg);
  padding: 48rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 24rpx;
}

.share-card-label {
  font-size: 22rpx;
  font-weight: 800;
  color: #888;
  letter-spacing: 8rpx;
  margin-bottom: 16rpx;
}

.share-card-score {
  font-size: 96rpx;
  font-weight: 900;
  color: var(--yellow);
  line-height: 1.1;
  margin-bottom: 16rpx;
}

.share-card-grade {
  margin-bottom: 20rpx;
}

.share-card-beat {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--lime);
  margin-bottom: 24rpx;
}

.share-card-cta {
  font-size: 20rpx;
  color: #666;
  font-weight: 600;
}

.share-gen-btn {
  margin-bottom: 8rpx;
}

/* ---- Speedrun 提示 ---- */
.section-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

/* ---- 成绩列表 ---- */
.score-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.score-card {
  margin-bottom: 0;
}

.score-header {
  padding: 20rpx 28rpx;
  border-bottom: var(--border);
}

.score-exam-name {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--fg);
}

.score-body {
  padding: 24rpx 28rpx;
}

.score-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.score-percent {
  font-size: 44rpx;
  font-weight: 900;
  color: var(--fg);
}

.score-grade {
  font-size: 22rpx;
}

.score-detail {
  font-size: 24rpx;
  color: var(--gray);
  display: block;
  margin-bottom: 4rpx;
}

.score-duration {
  font-size: 22rpx;
  color: var(--gray);
  display: block;
}

.score-empty {
  display: flex;
  justify-content: center;
  padding: 32rpx;
}

.score-no-data {
  color: #ccc;
  font-size: 26rpx;
  font-style: italic;
}

/* ---- 全部考试记录 ---- */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx;
  margin-bottom: 0;
}

.history-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.history-color-dot {
  width: 12rpx;
  height: 48rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.history-info {
  flex: 1;
  min-width: 0;
}

.history-top-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 4rpx;
}

.history-exam-name {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--fg);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.history-grade {
  font-size: 20rpx;
  flex-shrink: 0;
}

.history-claw {
  font-size: 22rpx;
  color: var(--gray);
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.history-date {
  font-size: 20rpx;
  color: #bbb;
  display: block;
  margin-top: 2rpx;
}

.history-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.history-percent {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--fg);
}

.history-score-detail {
  font-size: 20rpx;
  color: #999;
}

/* ---- 更多功能 ---- */
.more-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 28rpx;
  margin-bottom: 0;
}

.more-item + .more-item {
  margin-top: 12rpx;
}

.more-item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.more-item-icon {
  font-size: 36rpx;
}

.more-item-text {
  font-size: 28rpx;
  font-weight: 700;
}

.more-arrow {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--gray);
}

/* ---- 退出登录（融入更多功能列表） ---- */
.logout-item {
  margin-top: 12rpx;
  opacity: 0.6;
  transition: opacity 0.2s;
}

.logout-item:active {
  opacity: 0.9;
}

.logout-text {
  color: #999 !important;
}
