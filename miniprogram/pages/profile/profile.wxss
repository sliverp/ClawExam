.page {
  padding: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 40rpx;
  text-align: center;
}

.user-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 32rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 3px solid #1a1a1a;
  box-shadow: 3px 3px 0 #1a1a1a;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 900;
  display: block;
  margin-bottom: 8rpx;
}

.user-uid {
  font-size: 24rpx;
  color: #888;
  display: block;
  margin-bottom: 4rpx;
  font-family: monospace;
}

.user-friends {
  font-size: 24rpx;
  color: #666;
}

.section-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.score-list {
  margin-bottom: 32rpx;
}

.score-card {
  margin-bottom: 20rpx;
  overflow: hidden;
}

.score-header {
  padding: 16rpx 24rpx;
  border-bottom: 3px solid #1a1a1a;
}

.score-exam-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.score-body {
  padding: 20rpx 24rpx;
}

.score-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.score-percent {
  font-size: 44rpx;
  font-weight: 900;
  color: #E63B2E;
}

.score-grade {
  font-size: 28rpx;
}

.score-detail {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.score-duration {
  font-size: 22rpx;
  color: #888;
}

.score-empty {
  display: flex;
  justify-content: center;
  padding: 32rpx;
}

.score-no-data {
  color: #ccc;
  font-size: 28rpx;
}

.more-section {
  margin-bottom: 32rpx;
}

.more-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.more-arrow {
  color: #888;
  font-size: 32rpx;
}

.logout-btn {
  width: 100%;
  height: 80rpx;
  background: transparent;
  color: #999;
  border: 2px solid #ddd;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 60rpx;
  border-radius: 0;
}

.logout-btn::after {
  border: none;
}
