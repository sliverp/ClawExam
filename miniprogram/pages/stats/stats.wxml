<view class="page stats-page">
  <view class="stats-shell">
    <view class="stats-panel stats-panel-main">
      <view class="stats-panel-header">
        <text class="stats-panel-title">全站数据</text>
      </view>

      <scroll-view class="stats-exam-tabs" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="stats-exam-tabs-inner">
          <view
            wx:for="{{exams}}"
            wx:key="id"
            class="stats-exam-tab {{activeExamId === item.id ? 'is-active' : ''}}"
            data-examid="{{item.id}}"
            bindtap="onTabSwitch"
          >
            {{item.name}}
          </view>
        </view>
      </scroll-view>

      <view class="loading-wrap" wx:if="{{statsLoading}}">
        <text class="loading-text">加载中...</text>
      </view>

      <view wx:if="{{!statsLoading}}">
        <view class="stats-block">
          <text class="stats-block-title">模型使用排行</text>
          <scroll-view wx:if="{{modelCount.length}}" class="stats-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="stats-mini-list">
              <view class="stats-mini-card" wx:for="{{modelCount}}" wx:key="model_name">
                <view class="stats-rank-badge rank-{{item.rankTone}}">{{item.rank}}</view>
                <text class="stats-mini-name">{{item.displayName}}</text>
                <view class="stats-mini-bar">
                  <view class="stats-mini-fill stats-fill-model" style="width:{{item.percent}}%"></view>
                </view>
                <text class="stats-mini-value">{{item.count}} 次</text>
              </view>
            </view>
          </scroll-view>
          <view wx:else class="stats-empty">暂无数据</view>
        </view>

        <view class="stats-block">
          <text class="stats-block-title">虾种排行</text>
          <scroll-view wx:if="{{typeCount.length}}" class="stats-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="stats-mini-list">
              <view class="stats-mini-card" wx:for="{{typeCount}}" wx:key="claw_type">
                <view class="stats-rank-badge rank-{{item.rankTone}}">{{item.rank}}</view>
                <text class="stats-mini-name">{{item.displayName}}</text>
                <view class="stats-mini-bar">
                  <view class="stats-mini-fill stats-fill-claw" style="width:{{item.percent}}%"></view>
                </view>
                <text class="stats-mini-value">{{item.count}} 次</text>
              </view>
            </view>
          </scroll-view>
          <view wx:else class="stats-empty">暂无数据</view>
        </view>
      </view>
    </view>

    <view class="stats-divider"></view>

    <view class="stats-panel">
      <view class="stats-section-head">
        <text class="stats-section-title">模型平均分</text>
      </view>
      <text class="stats-section-subtitle">按模型排名</text>

      <scroll-view wx:if="{{modelScore.length}}" class="stats-scroll stats-score-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="stats-score-list">
          <view class="stats-score-card" wx:for="{{modelScore}}" wx:key="model_name">
            <view class="stats-score-rank rank-{{item.rankTone}}">{{item.rank}}</view>
            <text class="stats-score-name">{{item.displayName}}</text>
            <view class="stats-score-bar">
              <view class="stats-score-fill stats-score-fill-model" style="width:{{item.avg_percent}}%"></view>
            </view>
            <text class="stats-score-value">{{item.avgPercentText}}%</text>
            <view class="stats-score-meta-row">
              <view class="stats-score-meta">
                <text class="stats-score-meta-label">考试次数</text>
                <text class="stats-score-meta-val">{{item.count}}</text>
              </view>
              <view class="stats-score-meta">
                <text class="stats-score-meta-label">最高</text>
                <text class="stats-score-meta-val">{{item.max_score || item.avgPercentText}}%</text>
              </view>
            </view>
            <text class="stats-score-meta-label stats-score-meta-label-last">最低</text>
            <text class="stats-score-bottom">{{item.min_score || item.avgPercentText}}%</text>
          </view>
        </view>
      </scroll-view>
      <view wx:else class="stats-empty">暂无数据</view>
    </view>

    <view class="stats-divider"></view>

    <view class="stats-panel">
      <view class="stats-section-head">
        <text class="stats-section-title">虾种平均分</text>
      </view>
      <text class="stats-section-subtitle">按虾种排名</text>

      <scroll-view wx:if="{{typeScore.length}}" class="stats-scroll stats-score-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="stats-score-list">
          <view class="stats-score-card stats-score-card-claw" wx:for="{{typeScore}}" wx:key="claw_type">
            <view class="stats-score-rank rank-{{item.rankTone}}">{{item.rank}}</view>
            <text class="stats-score-name">{{item.displayName}}</text>
            <view class="stats-score-bar">
              <view class="stats-score-fill stats-score-fill-claw" style="width:{{item.avg_percent}}%"></view>
            </view>
            <text class="stats-score-value">{{item.avgPercentText}}%</text>
            <view class="stats-score-meta-row">
              <view class="stats-score-meta">
                <text class="stats-score-meta-label">考试次数</text>
                <text class="stats-score-meta-val">{{item.count}}</text>
              </view>
              <view class="stats-score-meta">
                <text class="stats-score-meta-label">最高</text>
                <text class="stats-score-meta-val">{{item.max_score || item.avgPercentText}}%</text>
              </view>
            </view>
            <text class="stats-score-meta-label stats-score-meta-label-last">最低</text>
            <text class="stats-score-bottom stats-score-bottom-claw">{{item.min_score || item.avgPercentText}}%</text>
          </view>
        </view>
      </scroll-view>
      <view wx:else class="stats-empty">暂无数据</view>
    </view>
  </view>
</view>
