.page {
  padding-bottom: 24rpx;
}

.stats-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #ffd968 0%, #ffe899 18%, #fff6da 42%, #fffaf0 100%);
}

.stats-shell {
  padding: 18rpx 12rpx 12rpx;
}

.stats-panel {
  padding: 18rpx 16rpx 20rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, rgba(255, 252, 240, 0.96) 0%, rgba(255, 255, 255, 0.96) 100%);
  box-shadow: 0 14rpx 26rpx rgba(204, 166, 54, 0.12);
}

.stats-panel-main {
  background: linear-gradient(180deg, #fff7ca 0%, #fffdf6 100%);
}

.stats-panel + .stats-panel {
  margin-top: 0;
}

.stats-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.stats-panel-title {
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 900;
  color: #3f2b00;
}

.stats-exam-tabs {
  margin: 0 -2rpx 18rpx;
  white-space: nowrap;
}

.stats-exam-tabs-inner {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 2rpx;
}

.stats-exam-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 62rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #8e8a82;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
}

.stats-exam-tab.is-active {
  background: #111;
  color: #fff;
}

.stats-block + .stats-block {
  margin-top: 28rpx;
}

.stats-block-title {
  display: block;
  margin-bottom: 14rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #8a7234;
}

.stats-scroll {
  white-space: nowrap;
  margin: 0 -4rpx;
}

.stats-mini-list {
  display: inline-flex;
  gap: 18rpx;
  padding: 0 4rpx;
}

.stats-mini-card {
  width: 250rpx;
  min-height: 214rpx;
  padding: 20rpx 18rpx 18rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 10rpx 22rpx rgba(227, 211, 158, 0.28);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
}

.stats-rank-badge {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
}

.rank-1 {
  background: linear-gradient(180deg, #ffb84a 0%, #ff9f26 100%);
}

.rank-2 {
  background: linear-gradient(180deg, #8fe2d9 0%, #4ec8bb 100%);
}

.rank-3 {
  background: linear-gradient(180deg, #c6b7ff 0%, #ad9cff 100%);
}

.rank-other {
  background: linear-gradient(180deg, #d4d4d4 0%, #b9b9b9 100%);
}

.stats-mini-name {
  display: block;
  width: 100%;
  margin-top: 18rpx;
  font-size: 18rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #77716c;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stats-mini-bar {
  width: 100%;
  height: 10rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #efefef;
  overflow: hidden;
}

.stats-mini-fill {
  height: 100%;
  border-radius: inherit;
}

.stats-fill-model {
  background: linear-gradient(90deg, #ffd659 0%, #ffbc37 100%);
}

.stats-fill-claw {
  background: linear-gradient(90deg, #66ded1 0%, #46c9bd 100%);
}

.stats-mini-value {
  margin-top: 20rpx;
  font-size: 40rpx;
  line-height: 1;
  font-weight: 900;
  color: #4a4036;
}

.stats-divider {
  width: 24rpx;
  height: 44rpx;
  margin: 4rpx 0 4rpx 8rpx;
  border-left: 8rpx solid #f0b400;
  border-bottom: 8rpx solid #f0b400;
  border-radius: 0 0 0 18rpx;
}

.stats-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stats-section-title {
  display: inline-block;
  position: relative;
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 900;
  color: #3f2b00;
}

.stats-section-title::after {
  content: '';
  position: absolute;
  left: -2rpx;
  right: -4rpx;
  bottom: 0;
  height: 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(118, 233, 221, 0.75) 0%, rgba(255, 223, 121, 0.8) 52%, rgba(255, 171, 124, 0.72) 100%);
  z-index: -1;
}

.stats-section-subtitle {
  display: block;
  margin-top: 10rpx;
  margin-bottom: 18rpx;
  font-size: 24rpx;
  color: #a29063;
  font-weight: 700;
}

.stats-score-scroll {
  margin: 0 -4rpx;
}

.stats-score-list {
  display: inline-flex;
  gap: 20rpx;
  padding: 0 4rpx;
}

.stats-score-card {
  width: 290rpx;
  min-height: 320rpx;
  padding: 20rpx 18rpx 18rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 10rpx 22rpx rgba(227, 211, 158, 0.28);
  box-sizing: border-box;
}

.stats-score-rank {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 18rpx;
  font-weight: 800;
  margin: 0 auto 16rpx;
}

.stats-score-name {
  display: block;
  min-height: 66rpx;
  font-size: 20rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #7a7686;
  text-align: center;
  white-space: normal;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stats-score-bar {
  width: 100%;
  height: 10rpx;
  margin-top: 16rpx;
  border-radius: 999rpx;
  background: #efeff7;
  overflow: hidden;
}

.stats-score-fill {
  height: 100%;
  border-radius: inherit;
}

.stats-score-fill-model {
  background: linear-gradient(90deg, #b0b2ff 0%, #7068ff 100%);
}

.stats-score-fill-claw {
  background: linear-gradient(90deg, #ffb6bb 0%, #ff6b72 100%);
}

.stats-score-value {
  display: block;
  margin-top: 18rpx;
  font-size: 46rpx;
  line-height: 1;
  font-weight: 900;
  color: #4b4744;
  text-align: center;
}

.stats-score-meta-row {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 26rpx;
  margin-top: 16rpx;
}

.stats-score-meta {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stats-score-meta-label {
  font-size: 18rpx;
  line-height: 1.2;
  color: #a9a2ad;
}

.stats-score-meta-val {
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #64606c;
}

.stats-score-bottom {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 900;
  color: #7a66ff;
  text-align: center;
}

.stats-score-bottom-claw {
  color: #ff7068;
}

.stats-score-meta-label-last {
  display: block;
  margin-top: 12rpx;
  text-align: center;
}

.stats-empty {
  padding: 28rpx 0 12rpx;
  text-align: center;
  color: #b1a481;
  font-size: 20rpx;
}

.loading-wrap {
  padding: 60rpx 0 46rpx;
  text-align: center;
}

.loading-text {
  font-size: 24rpx;
  color: #a18b4d;
}
