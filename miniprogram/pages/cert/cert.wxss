/* ============================================
   证书页 · Neobrutalism 爆款版
   ============================================ */
.page {
  padding-bottom: 40rpx;
}

.cert-content {
  padding: 32rpx;
}

/* ============================================
   分享卡片 - 为截图传播优化
   ============================================ */
.cert-share-card {
  background: linear-gradient(135deg, var(--fg) 0%, #2a2a2a 100%);
  border: var(--border-thick);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  padding: 48rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 32rpx;
}

.cert-share-title {
  font-size: 22rpx;
  font-weight: 800;
  color: #888;
  letter-spacing: 8rpx;
  margin-bottom: 16rpx;
}

.cert-share-score {
  font-size: 120rpx;
  font-weight: 900;
  color: var(--yellow);
  line-height: 1.1;
  margin-bottom: 12rpx;
}

.cert-share-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #ccc;
  margin-bottom: 8rpx;
}

.cert-share-meta {
  font-size: 22rpx;
  color: #888;
  margin-bottom: 20rpx;
}

.cert-share-challenge {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--lime);
  padding: 12rpx 28rpx;
  background: rgba(198,241,53,0.1);
  border: 2px solid var(--lime);
  border-radius: var(--radius-pill);
}

/* ============================================
   证书主体卡片
   ============================================ */
.cert-card {
  margin-bottom: 32rpx;
}

/* ---- Header ---- */
.cert-header {
  padding: 32rpx 32rpx;
  border-bottom: var(--border);
}

.cert-header-label {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  color: var(--fg);
  display: block;
  margin-bottom: 8rpx;
  opacity: 0.5;
}

.cert-header-exam {
  font-size: 36rpx;
  font-weight: 900;
  display: block;
  line-height: 1.3;
}

/* ---- Claw 信息 ---- */
.cert-claw {
  padding: 28rpx 32rpx;
  border-bottom: 2px dashed #e0e0e0;
}

.claw-name {
  font-size: 44rpx;
  font-weight: 900;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.2;
}

.claw-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

/* ---- 评级 ---- */
.grade-section {
  display: flex;
  align-items: center;
  padding: 32rpx;
  gap: 28rpx;
  border-bottom: 2px dashed #e0e0e0;
}

.grade-badge {
  width: 110rpx;
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  flex-shrink: 0;
}

.grade-letter {
  font-size: 56rpx;
  font-weight: 900;
}

.grade-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.grade-desc {
  font-size: 28rpx;
  font-weight: 800;
  display: block;
}

.grade-percent {
  font-size: 24rpx;
  color: var(--gray);
  display: block;
}

/* ---- 毕业标记 ---- */
.graduated-badge {
  padding: 20rpx 32rpx;
  background: var(--bg-alt);
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  border-bottom: 2px dashed #e0e0e0;
}

/* ---- 统计网格 ---- */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-bottom: 2px dashed #e0e0e0;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 8rpx;
  border-right: 2px dashed #e0e0e0;
}

.stats-item:last-child {
  border-right: none;
}

.stats-value {
  font-size: 32rpx;
  font-weight: 900;
  margin-bottom: 4rpx;
}

.stats-label {
  font-size: 20rpx;
  color: var(--gray);
  font-weight: 600;
}

/* ---- 快速作答警告 ---- */
.speedrun-warn {
  padding: 20rpx 32rpx;
  background: #FFF3CD;
  border-bottom: 2px dashed #e0e0e0;
  font-size: 24rpx;
  font-weight: 700;
  color: #856404;
}

/* ---- 各维度得分 ---- */
.sub-title {
  font-size: 28rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 20rpx;
}

.category-section {
  padding: 28rpx 32rpx;
  border-bottom: 2px dashed #e0e0e0;
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.cat-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.cat-name {
  font-weight: 700;
  font-size: 24rpx;
}

.cat-score {
  font-weight: 800;
  font-size: 24rpx;
  color: var(--fg);
}

/* ---- 技能标签 ---- */
.skills-section {
  padding: 28rpx 32rpx;
  border-bottom: 2px dashed #e0e0e0;
}

.skills-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.skill-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
}

/* ---- 勋章 ---- */
.badges-section {
  padding: 28rpx 32rpx;
  border-bottom: 2px dashed #e0e0e0;
}

.badges-wrap {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.badge-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 0;
  box-shadow: var(--shadow-sm);
}

.badge-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.badge-info {
  flex: 1;
}

.badge-name {
  font-size: 26rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 2rpx;
}

.badge-desc {
  font-size: 22rpx;
  color: var(--gray);
  display: block;
}

/* ---- 证书图片 ---- */
.cert-image-section {
  padding: 28rpx 32rpx;
  border-bottom: 2px dashed #e0e0e0;
}

.cert-image {
  width: 100%;
  border: var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

/* ---- 准考证号 ---- */
.token-section {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--gray-light);
  border-radius: 0 0 var(--radius) var(--radius);
}

.token-label {
  font-size: 22rpx;
  color: var(--gray);
  font-weight: 700;
  margin-bottom: 8rpx;
}

.token-value {
  font-size: 22rpx;
  color: var(--fg);
  word-break: break-all;
  text-align: center;
  line-height: 1.5;
}

/* ---- 操作按钮 ---- */
.cert-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
