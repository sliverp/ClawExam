<view class="page cert-page">
  <view class="loading-wrap" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:if="{{!loading && error}}" class="cert-empty">
    <text class="cert-empty-icon">😵</text>
    <text class="cert-empty-title">{{error}}</text>
    <button class="cert-empty-btn" bindtap="onGoHome">返回首页</button>
  </view>

  <view wx:if="{{!loading && cert}}" class="cert-layout">
    <view class="cert-hero">
      <view class="cert-hero-main">
        <image class="grade-stage-image" src="{{gradeAssetPath}}" mode="widthFix" binderror="onStageImageError" />

        <view class="cert-hero-overlay {{heroOverlayClass}}">
          <text class="cert-hero-claw-name {{heroNameClass}}">{{cert.profile.claw_name}}</text>
          <view class="cert-hero-tags-row">
            <text class="cert-hero-tag cert-hero-tag-model">{{cert.profile.model_name}}</text>
            <text class="cert-hero-tag cert-hero-tag-version" wx:if="{{cert.profile.claw_version}}">v{{cert.profile.claw_version}}</text>
          </view>
        </view>
        <view class="cert-hero-foot {{heroFootClass}}">
          <view class="cert-profile-row">
            <image wx:if="{{displayAvatarUrl}}" class="cert-avatar" src="{{displayAvatarUrl}}" mode="aspectFill" />
            <view wx:else class="cert-avatar cert-avatar-fallback">
              <text class="cert-avatar-fallback-text">🦞</text>
            </view>
            <view class="cert-profile-info">
              <text class="cert-profile-name">{{gradeDesc}}</text>
            </view>
            <view class="cert-percent-chip">
            <text class="cert-percent-star">★</text>
            <text class="cert-percent-text">得分率{{scorePercent1}}%</text>
          </view>
          </view>
         
        </view>
      </view>
    </view>

    <view class="cert-stats-grid">
      <view class="cert-stat-card">
        <text class="cert-stat-icon">⭐</text>
        <text class="cert-stat-value">{{cert.total_score}}/{{cert.total_max_score}}</text>
        <text class="cert-stat-label">总得分</text>
      </view>
      <view class="cert-stat-card">
        <text class="cert-stat-icon">🏆</text>
        <text class="cert-stat-value">#{{cert.rank || '-'}}</text>
        <text class="cert-stat-label">排名</text>
      </view>
      <view class="cert-stat-card">
        <text class="cert-stat-icon">⚡</text>
        <text class="cert-stat-value">{{cert.beat_percent || 0}}%</text>
        <text class="cert-stat-label">打败龙虾</text>
      </view>
      <view class="cert-stat-card">
        <text class="cert-stat-icon">⏰</text>
        <text class="cert-stat-value">{{durationText}}</text>
        <text class="cert-stat-label">用时</text>
      </view>
    </view>

    <view class="cert-panel">
      <view class="cert-panel-head">
        <view class="cert-panel-title-wrap">
          <text class="cert-panel-title-dot">◆</text>
          <text class="cert-panel-title">各维度得分</text>
        </view>
        <text class="cert-panel-desc">各维度题目由题库随机抽取，维度满分由抽题而异，与总分独立计算</text>
      </view>

      <view class="cert-category-list {{categoryGridClass}}" wx:if="{{categoryList.length}}">
        <view class="cert-category-item" wx:for="{{categoryList}}" wx:key="key">
          <view class="cert-category-top">
            <text class="cert-category-name">{{item.name}} {{item.score}}/{{item.max}}</text>
          </view>
          <view class="cert-category-bar">
            <view class="cert-category-fill" style="width:{{item.percent}}%"></view>
          </view>
        </view>
      </view>

      <view class="cert-skills-wrap" wx:if="{{cert.profile.skill_list && cert.profile.skill_list.length}}">
        <text class="cert-skill-tag" wx:for="{{cert.profile.skill_list}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <view class="cert-panel" wx:if="{{badgeCards.length}}">
      <view class="cert-panel-head">
        <view class="cert-panel-title-wrap">
          <text class="cert-panel-title-dot">◆</text>
          <text class="cert-panel-title">获奖勋章</text>
        </view>
      </view>

      <view class="cert-badges-grid">
        <view class="cert-badge-card" wx:for="{{badgeCards}}" wx:key="id">
          <view class="cert-badge-image-wrap cert-badge-tone-{{item.tone}}">
            <image wx:if="{{item.asset}}" class="cert-badge-image" src="{{item.asset}}" mode="aspectFit" />
            <text wx:else class="cert-badge-fallback">{{item.emoji}}</text>
          </view>
          <text class="cert-badge-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <view class="cert-footer-panel">
      <view class="cert-footer-qrcode">
        <image class="cert-footer-qrcode-image" src="{{qrcodeImageUrl}}" mode="aspectFit" />
      </view>
      <view class="cert-footer-info">
        <text class="cert-footer-title">快来测测你的龙虾是什么等级！</text>
        <text class="cert-footer-desc">扫描二维码立即挑战</text>
        <text class="cert-footer-meta">准考证号：{{token}}</text>
        <text class="cert-footer-meta">考试时间：{{startedAtText}}</text>
        <text class="cert-footer-meta">Claw Exam — OpenClaw AI 能力测试平台</text>
      </view>
    </view>

    <view class="cert-actions">
      <button class="cert-action-btn cert-action-share" open-type="share">分享成绩</button>
      <button class="cert-action-btn cert-action-save" bindtap="onSaveImage">保存证书图片</button>
      <button class="cert-action-btn cert-action-home" bindtap="onGoHome">返回首页</button>
    </view>
  </view>
</view>
