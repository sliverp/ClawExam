/* ============================================
   首页 · Neobrutalism 爆款版
   ============================================ */
.page {
  padding-bottom: 40rpx;
}

/* ============================================
   全屏 Hero - 第一眼就炸
   ============================================ */
.hero-fullscreen {
  position: relative;
  min-height: 680rpx;
  background: var(--fg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx 60rpx;
  overflow: hidden;
}

.hero-main-emoji {
  font-size: 140rpx;
  margin-bottom: 24rpx;
  animation: float 3s ease-in-out infinite;
  filter: drop-shadow(4px 4px 0 rgba(255,217,61,0.4));
}

.hero-title-wrap {
  text-align: center;
  margin-bottom: 16rpx;
}

.hero-title-sm {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #999;
  margin-bottom: 8rpx;
  letter-spacing: 8rpx;
}

.hero-title-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.hero-title-lg {
  font-size: 64rpx;
  font-weight: 900;
  color: #fff;
  line-height: 1.15;
}

.hero-title-accent {
  font-size: 64rpx;
  font-weight: 900;
  color: var(--yellow);
  line-height: 1.15;
}

.hero-subtitle {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 40rpx;
  text-align: center;
}

.hero-cta {
  background: var(--yellow) !important;
  font-size: 34rpx !important;
  padding: 28rpx 64rpx !important;
  animation: pulse 2s ease-in-out infinite;
}

.hero-live-strip {
  width: 100%;
  margin-top: 36rpx;
  background: rgba(255,255,255,0.08);
  border-radius: var(--radius);
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.live-dot {
  width: 16rpx;
  height: 16rpx;
  background: var(--red);
  border-radius: 50%;
  animation: pulse 1.5s ease-in-out infinite;
  flex-shrink: 0;
}

.live-text {
  font-size: 24rpx;
  color: #ccc;
  font-weight: 600;
}

.live-count {
  color: var(--yellow);
  font-weight: 800;
}

/* ============================================
   滚动标语条 - 黄底黑字更醒目
   ============================================ */
.marquee-strip {
  background: var(--yellow);
  padding: 18rpx 0;
  overflow: hidden;
  white-space: nowrap;
  border-top: var(--border);
  border-bottom: var(--border);
}

.marquee-text {
  display: inline-block;
  color: var(--fg);
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  animation: marquee 15s linear infinite;
}

/* ============================================
   社交证明数据条
   ============================================ */
.social-proof {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  padding: 28rpx 24rpx;
  background: var(--white);
  border-bottom: var(--border);
}

.proof-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.proof-num {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--fg);
  line-height: 1.2;
}

.proof-label {
  font-size: 20rpx;
  color: var(--gray);
  font-weight: 600;
}

.proof-divider {
  width: 2rpx;
  height: 56rpx;
  background: #e0e0e0;
  flex-shrink: 0;
}

/* ============================================
   考试卡片 - 可展开的简洁版
   ============================================ */
.exam-section {
  padding-top: 36rpx;
}

.exam-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.exam-card {
  margin-bottom: 0;
}

.exam-card-mini {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 28rpx;
}

.exam-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border: var(--border);
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.exam-icon {
  font-size: 48rpx;
}

.exam-info {
  flex: 1;
  min-width: 0;
}

.exam-name {
  font-size: 32rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 4rpx;
}

.exam-meta {
  font-size: 24rpx;
  color: var(--gray);
  font-weight: 600;
}

.exam-arrow {
  font-size: 40rpx;
  font-weight: 900;
  color: #ccc;
  flex-shrink: 0;
}

/* 展开详情 */
.exam-detail {
  padding: 0 28rpx 28rpx;
  border-top: 2px dashed #e0e0e0;
  margin-top: 0;
  padding-top: 24rpx;
}

.exam-desc {
  font-size: 26rpx;
  color: var(--gray-dark);
  line-height: 1.7;
  display: block;
  margin-bottom: 20rpx;
}

.exam-cmd-box {
  background: var(--bg-alt);
  border: 2px dashed var(--fg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.exam-cmd-label {
  font-size: 20rpx;
  font-weight: 800;
  color: var(--gray);
  text-transform: uppercase;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 8rpx;
}

.exam-cmd-text {
  font-size: 24rpx;
  color: var(--fg);
  line-height: 1.6;
  word-break: break-all;
}

/* 按钮行 - 邀请70% + 复制30% */
.exam-btn-row {
  display: flex;
  gap: 16rpx;
}

.exam-btn-invite {
  flex: 7;
  font-size: 28rpx !important;
  padding: 24rpx 0 !important;
  min-width: 0;
}

.exam-btn-copy {
  flex: 3;
  font-size: 26rpx !important;
  padding: 24rpx 0 !important;
  background: var(--white) !important;
  min-width: 0;
}

.exam-btn-invite::after, .exam-btn-copy::after { border: none; }

/* ============================================
   排行榜
   ============================================ */
.lb-section {
  padding-top: 36rpx;
}

.lb-tab-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.lb-tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  border: var(--border);
  font-weight: 800;
  font-size: 26rpx;
  background: var(--white);
  border-radius: var(--radius);
  white-space: nowrap;
}

.lb-tab-item::after { border: none; }

.lb-tab-item.active {
  box-shadow: var(--shadow-sm);
  color: var(--fg);
}

/* ---- 领奖台 (前三名) ---- */
.lb-podium {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 16rpx;
  padding: 32rpx 16rpx 0;
  margin-bottom: 36rpx;
}

.podium-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  max-width: 220rpx;
}

.podium-medal {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.podium-crown {
  font-size: 56rpx;
  margin-bottom: 8rpx;
  animation: float 3s ease-in-out infinite;
}

.podium-name {
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.podium-score {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--red);
  margin-bottom: 12rpx;
}

.podium-score-gold {
  font-size: 40rpx;
  color: var(--red);
}

.podium-bar {
  width: 100%;
  border: var(--border);
  border-bottom: none;
  border-radius: var(--radius) var(--radius) 0 0;
}

/* ---- 排行榜列表 (4名起) ---- */
.lb-rest-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.lb-item {
  display: flex;
  flex-direction: row;
  margin-bottom: 0;
  border-radius: var(--radius);
}

.lb-rank {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: var(--border);
  flex-shrink: 0;
  background: var(--gray-light);
}

.lb-rank-num {
  font-size: 32rpx;
  font-weight: 900;
}

.lb-info {
  flex: 1;
  padding: 24rpx 28rpx;
  min-width: 0;
}

.lb-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.lb-name {
  font-size: 28rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lb-model-tag {
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  flex-shrink: 0;
}

.lb-score-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.lb-score-bar { flex: 1; }

.lb-score-text {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--red);
  white-space: nowrap;
  min-width: 90rpx;
  text-align: right;
}

.lb-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.lb-meta-text {
  font-size: 22rpx;
  color: var(--gray);
}

.lb-cert-link {
  font-size: 24rpx;
  color: var(--red);
  font-weight: 700;
}

/* ============================================
   挑衅式 CTA - 红色大块
   ============================================ */
.challenge-cta {
  margin: 0 32rpx 32rpx;
  background: var(--red);
  border: var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-lg);
  padding: 48rpx 36rpx;
  text-align: center;
}

.challenge-cta:active {
  box-shadow: var(--shadow-active);
  transform: translate(3px, 3px);
}

.challenge-emoji {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
  animation: shake 2s ease-in-out infinite;
}

.challenge-title {
  font-size: 44rpx;
  font-weight: 900;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.challenge-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

/* ============================================
   查证书
   ============================================ */
.cert-section {
  padding-top: 8rpx;
}

.cert-search-card {
  background: var(--yellow);
}

.cert-search-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 28rpx;
  border-bottom: var(--border);
}

.cert-search-icon {
  font-size: 36rpx;
}

.cert-search-title {
  font-size: 32rpx;
  font-weight: 900;
}

.cert-search-body {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  align-items: center;
}

.cert-input {
  flex: 1;
  height: 80rpx;
  border: var(--border);
  padding: 0 24rpx;
  background: var(--white);
  font-size: 28rpx;
  border-radius: 12rpx;
}

.cert-search-btn {
  flex-shrink: 0;
  height: 80rpx;
}
