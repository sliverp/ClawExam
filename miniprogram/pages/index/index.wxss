.home-page {
  min-height: 100vh;
  padding-bottom: 0;
  font-family: "PingFang SC", "SF Pro Text", -apple-system, BlinkMacSystemFont, sans-serif;
  background:
    radial-gradient(circle at 18% 8%, rgba(255, 155, 103, 0.9) 0, rgba(255, 155, 103, 0.35) 22%, transparent 40%),
    radial-gradient(circle at 82% 9%, rgba(214, 255, 89, 0.92) 0, rgba(214, 255, 89, 0.3) 20%, transparent 38%),
    linear-gradient(180deg, #fff7d4 0%, #ffd965 56%, #f7c64f 100%);
}

.home-page view,
.home-page text,
.home-page button,
.home-page input {
  font-family: "PingFang SC", "SF Pro Text", -apple-system, BlinkMacSystemFont, sans-serif;
}

.hero-shell {
  position: relative;
  overflow: hidden;

}

.hero-main-image {
  display: block;
  width: 105%;
}

.hero-security-badge {
  width: calc(100% - 64rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rpx;
  padding: 5rpx 24rpx 5rpx;
  border-radius: 28rpx;
  background: rgba(0, 102, 255, 0.31);
  box-shadow: 0 10rpx 24rpx rgba(46, 30, 8, 0.14);
  box-sizing: border-box;
}

.hero-security-strip {
  margin: 8rpx auto 12rpx;
}

.hero-security-logo-large {
  width: 200rpx;
  flex-shrink: 0;
}

.hero-security-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  width: 100%;
}

.hero-security-copy-stacked {
  align-items: center;
}

.hero-security-line {
  font-size: 22rpx;
  line-height: 1.2;
  color: rgba(255, 255, 255, 0.88);
}

.hero-security-line-accent {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: center;
  gap: 6rpx;
  width: 100%;
}

.hero-security-brand {
  font-size: 18rpx;
  line-height: 1.2;
  color: #71a8ff;
  font-weight: 700;
}

.hero-security-text {
  font-size: 18rpx;
  line-height: 1.2;
  color: rgba(255, 255, 255, 0.88);
}

.hero-security-text-inline {
  white-space: nowrap;
}

.stats-panel {
  position: relative;
  z-index: 1;
  margin: -175rpx 16rpx 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 2rpx 0;
  padding: 28rpx 26rpx;
  border-radius: 34rpx;
  background: rgba(255, 251, 235, 0.96);
  box-shadow: 0 20rpx 30rpx rgba(175, 112, 16, 0.12);
}

.stats-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-num {
  font-size: 44rpx;
  line-height: 1.15;
  font-weight: 800;
  color: #3b342d;
}

.stats-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(59, 52, 45, 0.7);
}

.card-section {
  position: relative;
  margin: 0 28rpx 30rpx;
  padding: 28rpx;
  border-radius: 34rpx;
  background: linear-gradient(180deg, rgba(255, 248, 212, 0.92) 0%, rgba(255, 244, 202, 0.76) 100%);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.42), 0 14rpx 28rpx rgba(176, 122, 23, 0.1);
}

.section-connected {
  margin-top: 2rpx;
}

.section-connector {
  position: absolute;
  left: 8rpx;
  top: -66rpx;
  width: 66rpx;
  height: 96rpx;
  z-index: 2;
  pointer-events: none;
}

.section-connector-stem {
  position: absolute;
  left: -2rpx;
  top: 30rpx;
  width: 8rpx;
  height: 45rpx;
  border-radius: 999rpx;
  background: #f6ab14;
}

.section-connector-hook {
  position: absolute;
  left: 20rpx;
  top: 6rpx;
  width: 28rpx;
  height: 82rpx;
  border: 8rpx solid #f6ab14;
  border-left: 0;
  border-radius: 0 999rpx 999rpx 0;
  box-sizing: border-box;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.section-head-inline {
  align-items: center;
  justify-content: flex-start;
}

.section-head-main {
  min-width: 0;
}

.section-head-main-inline {
  display: flex;
  align-items: center;
  gap: 26rpx;
  min-width: 0;
}

.section-title-tight {
  display: inline-block;
  position: relative;
  margin-bottom: 8rpx;
  font-size: 44rpx;
  line-height: 56rpx;
  font-weight: 600;
  letter-spacing: 0;
  color: #111111;
}

.section-title-wrap {
  display: inline-block;
  position: relative;
}

.section-title-wrap::before {
  content: '';
  position: absolute;
  left: 0;
  bottom: 8rpx;
  width: 92%;
  height: 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(118, 233, 221, 0.75) 0%, rgba(255, 223, 121, 0.8) 52%, rgba(255, 171, 124, 0.72) 100%);
  z-index: 0;
}

.section-title-wrap .section-title-tight {
  position: relative;
  z-index: 1;
}

.section-subtitle {
  margin-bottom: 0;
  color: rgba(84, 72, 55, 0.66);
}

.section-head-main-inline .section-subtitle {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 34rpx;
  white-space: nowrap;
}

.section-mark {
  font-size: 34rpx;
  line-height: 1;
  opacity: 0.9;
}

.exam-list,
.rank-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.exam-card,
.rank-item,
.cta-panel,
.cert-panel {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  box-shadow: 0 10rpx 20rpx rgba(115, 88, 31, 0.08);
}

.exam-card {
  padding: 24rpx 22rpx 18rpx;
}

.exam-card-expanded {
  padding-bottom: 24rpx;
}

.exam-card-main {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding-right: 190rpx;
  min-height: 96rpx;
}

.exam-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  color: #fff;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.6);
  flex-shrink: 0;
  overflow: hidden;
}

.exam-icon-img {
  width: 100%;
  height: 100%;
}

.exam-copy {
  flex: 1;
  min-width: 0;
  padding-right: 8rpx;
}

.exam-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.exam-name {
  display: block;
  flex: 0 1 auto;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  font-family: "PingFang SC", "SF Pro Text", -apple-system, BlinkMacSystemFont, sans-serif;
  color: #2b2b2b;
  line-height: 44rpx;
  word-break: break-word;
}

.exam-version {
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
  background: #eef2ff;
  color: #5f6fff;
  font-size: 20rpx;
  font-weight: 700;
}

.exam-meta {
  display: block;
  font-size: 24rpx;
  color: rgba(78, 78, 78, 0.64);
}

.exam-desc {
  display: block;
  margin-top: 24rpx;
  font-size: 22rpx;
  color: rgba(78, 78, 78, 0.58);
  line-height: 1.6;
}

.exam-cta,
.exam-share,
.cta-btn,
.cert-btn {
  border: none;
}

.exam-cta::after,
.exam-share::after,
.cta-btn::after,
.cert-btn::after {
  border: none;
}

.exam-cta {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 156rpx;
  height: 72rpx;
  padding: 0;
  border-radius: 22rpx;
  background: #050505;
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
  white-space: nowrap;
}

.exam-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.exam-foot-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.security-logo {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.security-text {
  font-size: 20rpx;
  color: #6c7efb;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.exam-share {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  padding: 0 20rpx;
  height: 54rpx;
  border-radius: 999rpx;
  background: #fff1d0;
  color: #a45b0f;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
  box-sizing: border-box;
}

.exam-detail {
  margin-top: 20rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid rgba(202, 183, 140, 0.28);
}

.exam-command-box {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, rgba(255, 244, 205, 0.8) 0%, rgba(255, 248, 227, 0.94) 100%);
  box-shadow: inset 0 0 0 2rpx rgba(224, 197, 130, 0.38);
}

.exam-command-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(111, 100, 85, 0.72);
}

.exam-command-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.7;
  color: #3b342d;
  word-break: break-all;
}

.exam-detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.exam-copy-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #ff6248 0%, #ff4d34 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 18rpx rgba(255, 96, 72, 0.18);
}

.exam-detail-actions .exam-share {
  width: 200rpx;
  height: 80rpx;
  background: rgba(255, 245, 220, 0.96);
  font-size: 28rpx;
  border-radius: 22rpx;
}

.philosophy-head {
  margin-bottom: 14rpx;
}

.philosophy-quote {
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.8) 0%, rgba(255, 247, 223, 0.96) 100%);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.42);
}

.philosophy-quote-text {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(61, 51, 36, 0.82);
}

.philosophy-roadmap {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.philosophy-step {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 10rpx 22rpx rgba(140, 102, 24, 0.08);
}

.philosophy-step-tag {
  width: 104rpx;
  height: 52rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 800;
}

.philosophy-step-main {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.philosophy-step-title {
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 800;
  color: #222;
}

.philosophy-step-desc {
  font-size: 20rpx;
  line-height: 1.55;
  color: rgba(80, 69, 54, 0.72);
}

.philosophy-step-v1 .philosophy-step-tag {
  background: rgba(110, 231, 183, 0.22);
  color: #179b70;
}

.philosophy-step-v2 .philosophy-step-tag {
  background: rgba(95, 111, 255, 0.14);
  color: #5f6fff;
}

.philosophy-step-v3 .philosophy-step-tag {
  background: rgba(255, 107, 53, 0.16);
  color: #ff6b35;
}

.rank-tabs {
  width: 100%;
  margin-bottom: 26rpx;
}

.rank-tabs-inner {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.rank-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  padding: 16rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  color: rgba(40, 40, 40, 0.72);
  font-size: 24rpx;
  text-align: center;
}

.rank-tab.active {
  background: #050505;
  color: #fff;
}

.podium-board {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 14rpx;
  padding: 8rpx 0 22rpx;
}

.podium-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.podium-avatar {
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  background: linear-gradient(180deg, #fff8ea 0%, #ffe3ad 100%);
  font-size: 42rpx;
}

.podium-avatar-first {
  width: 92rpx;
  height: 92rpx;
  font-size: 50rpx;
}

.podium-name,
.podium-name-first {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #2e2a25;
}

.podium-name {
  font-size: 24rpx;
}

.podium-name-first {
  font-size: 28rpx;
  font-weight: 800;
}

.podium-score {
  margin-top: 6rpx;
  font-size: 42rpx;
  line-height: 1.1;
  font-weight: 900;
  color: #ff8b22;
}

.podium-score-first {
  font-size: 56rpx;
  color: #ff7a18;
}

.podium-bar {
  width: 100%;
  margin-top: 12rpx;
  border-radius: 26rpx 26rpx 0 0;
}

.podium-bar-first {
  height: 200rpx;
  background: linear-gradient(180deg, #ff6868 0%, rgba(255, 104, 104, 0.1) 100%);
}

.podium-bar-second {
  height: 144rpx;
  background: linear-gradient(180deg, #ff9a67 0%, rgba(255, 154, 103, 0.08) 100%);
}

.podium-bar-third {
  height: 124rpx;
  background: linear-gradient(180deg, #ffd448 0%, rgba(255, 212, 72, 0.12) 100%);
}

.my-rank-banner {
  margin-bottom: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
}

.my-rank-text {
  font-size: 24rpx;
  color: rgba(60, 52, 45, 0.74);
}

.rank-gap {
  text-align: center;
  font-size: 38rpx;
  color: rgba(85, 75, 62, 0.48);
  letter-spacing: 12rpx;
}

.rank-item {
  display: flex;
  align-items: stretch;
  padding: 22rpx;
  border-radius: 28rpx;
}

.rank-item-me {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 246, 240, 0.98) 100%);
  box-shadow: inset 0 0 0 3rpx rgba(255, 102, 72, 0.72), 0 12rpx 24rpx rgba(115, 88, 31, 0.1);
}

.rank-num {
  width: 70rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 700;
  color: #b9a280;
  border-radius: 18rpx;
  background: rgba(255, 247, 221, 0.56);
}

.rank-num-me {
  background: linear-gradient(180deg, #ff6948 0%, #ff533a 100%);
  color: #fff7ef;
  box-shadow: 0 8rpx 16rpx rgba(255, 95, 68, 0.18);
}

.rank-body {
  flex: 1;
  min-width: 0;
}

.rank-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.rank-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 34rpx;
  font-weight: 800;
  color: #292723;
}

.rank-tag,
.rank-model {
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  font-size: 18rpx;
  font-weight: 700;
}

.rank-tag {
  background: linear-gradient(180deg, #ff7a58 0%, #ff5a3f 100%);
  color: #fff7ed;
  padding: 4rpx 16rpx;
  box-shadow: 0 6rpx 12rpx rgba(255, 98, 67, 0.16);
}

.rank-model {
  background: #fff2a6;
  color: #8a6b1b;
}

.rank-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.rank-progress-bar {
  flex: 1;
  height: 16rpx;
  border-radius: 999rpx;
  background: #ffe9a4;
  overflow: hidden;
}

.rank-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #ffd45d 0%, #ff8f2c 100%);
}

.rank-score {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 900;
  color: #ff4f44;
}

.rank-item-me .rank-name {
  color: #1f1d1b;
}

.rank-item-me .rank-model {
  background: #ffeaa0;
  color: #775314;
}

.rank-item-me .rank-progress-bar {
  background: #ffd8b1;
}

.rank-item-me .rank-progress-fill {
  background: linear-gradient(90deg, #ffcf53 0%, #ff8c2b 100%);
}

.rank-item-me .rank-score,
.rank-item-me .rank-cert {
  color: #ff5d48;
}

.rank-meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
}

.rank-meta {
  font-size: 20rpx;
  color: rgba(74, 74, 74, 0.44);
}

.rank-cert {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 700;
  color: #ff4f44;
}

.cta-panel {
  margin-top: 22rpx;
  padding: 50rpx 28rpx 42rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background: linear-gradient(180deg, rgba(255, 247, 221, 0.95) 0%, rgba(249, 240, 219, 0.95) 100%);
}

.cta-emoji {
  font-size: 72rpx;
  margin-bottom: 10rpx;
}

.cta-title {
  font-size: 48rpx;
  font-weight: 900;
  color: #25201d;
}

.cta-desc {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: rgba(80, 74, 67, 0.5);
}

.cta-btn {
  margin-top: 28rpx;
  min-width: 244rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #050505;
  color: #fff;
  font-size: 32rpx;
  font-weight: 800;
}

.cert-panel {
  padding: 28rpx;
  background: linear-gradient(180deg, rgba(255, 233, 233, 0.92) 0%, rgba(255, 240, 240, 0.95) 100%);
}

.cert-title {
  display: block;
  margin-bottom: 24rpx;
  font-size: 42rpx;
  font-weight: 600;
  color: #3c3434;
}

.cert-form {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cert-input {
  flex: 1;
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: #fff;
  box-sizing: border-box;
  color: #444;
}

.cert-btn {
  width: 148rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #ff6969 0%, #ff5656 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
}

.footer {
  padding: 12rpx 32rpx 8rpx;
  text-align: center;
}

.footer-text {
  display: inline-block;
  color: rgba(255, 255, 255, 0.95);
  font-size: 22rpx;
  font-weight: 700;
}

.fab-arena {
  position: fixed;
  left: 28rpx;
  bottom: calc(124rpx + env(safe-area-inset-bottom));
  z-index: 98;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  background: #050505;
  color: #fff;
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, 0.18);
}

.fab-arena-icon {
  font-size: 28rpx;
}

.fab-arena-text {
  font-size: 24rpx;
  font-weight: 800;
}

.fab-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 98;
  background: rgba(0, 0, 0, 0.24);
}

.fab-menu {
  position: fixed;
  left: 28rpx;
  bottom: calc(214rpx + env(safe-area-inset-bottom));
  z-index: 99;
