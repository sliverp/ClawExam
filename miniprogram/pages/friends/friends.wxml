<view class="page friends-page">
  <view wx:if="{{!isLoggedIn}}" class="empty-state">
    <text class="empty-icon">👥</text>
    <text class="empty-title">登录后查看好友排行榜</text>
    <text class="empty-desc">和好友比一比，谁的虾更厉害</text>
    <button class="friends-login-btn" bindtap="onGoLogin">立即登录</button>
  </view>

  <view wx:if="{{isLoggedIn}}" class="friends-layout">
    <view class="friends-hero">
      <text class="friends-hero-title">好友排行榜</text>
      <text class="friends-hero-desc">{{friendCount || 0}} 位好友 ・ {{leaderboard.length}} 人有成绩</text>
    </view>

    <view class="friends-invite-shell">
      <view class="friends-invite-card">
        <view class="friends-invite-text">
          <text class="friends-invite-title">邀请好友一起来</text>
          <text class="friends-invite-desc">分享小程序，好友打开即可自动添加</text>
        </view>
        <button class="friends-invite-btn" open-type="share">邀请</button>
      </view>
    </view>

    <view class="friends-board">
      <scroll-view class="friends-tab-scroll" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{exams.length}}">
        <view class="friends-tab-list">
          <view
            wx:for="{{exams}}"
            wx:key="id"
            class="friends-tab-item {{activeExamId === item.id ? 'is-active' : ''}}"
            data-examid="{{item.id}}"
            bindtap="onTabSwitch"
          >
            {{item.name}}
          </view>
        </view>
      </scroll-view>

      <view class="loading-wrap" wx:if="{{loading}}">
        <text class="loading-text">加载中...</text>
      </view>

      <view wx:if="{{!loading && leaderboard.length}}" class="friends-rank-list">
        <view class="friends-rank-card {{item.is_me ? 'is-me' : ''}}" wx:for="{{leaderboard}}" wx:key="session_id">
          <text class="friends-rank-num">{{item.rank}}</text>
          <image class="friends-rank-avatar" src="{{item.avatar_url || '/images/default-avatar.png'}}" mode="aspectFill" />

          <view class="friends-rank-main">
            <view class="friends-rank-name-row">
              <text class="friends-rank-name">{{item.nickname}}</text>
              <text wx:if="{{item.grade}}" class="friends-rank-grade">{{item.grade}}</text>
              <text wx:if="{{item.is_me}}" class="friends-rank-me">我</text>
            </view>
            <view class="friends-rank-score-row">
              <text class="friends-rank-score-label">得分</text>
              <text class="friends-rank-score-main">{{item.scoreValue}}</text>
              <text class="friends-rank-score-dot">·</text>
              <text class="friends-rank-score-sub-label">满分</text>
              <text class="friends-rank-score-sub">{{item.maxValue}}</text>
            </view>
            <text class="friends-rank-meta">{{item.model_name}} ・ {{item.claw_name || item.claw_type || 'OpenClaw'}}</text>
            <text class="friends-rank-time">{{item.dateText}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{!loading && !leaderboard.length}}" class="friends-empty">暂无好友成绩</view>
    </view>
  </view>

  <login-popup show="{{showLoginPopup}}" bind:close="onLoginClose" bind:success="onLoginSuccess" />
</view>
