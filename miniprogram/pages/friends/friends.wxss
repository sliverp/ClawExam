.page {
  padding: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  text-align: center;
}

.empty-desc {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 40rpx;
}

.lb-tab-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.lb-tab-item {
  padding: 12rpx 24rpx;
  border: 3px solid #1a1a1a;
  font-weight: 700;
  font-size: 24rpx;
  background: #fff;
}

.lb-tab-item::after {
  border: none;
}

.lb-tab-item.active {
  background: var(--yellow);
  box-shadow: 3px 3px 0 #1a1a1a;
}

.lb-list {
  margin-bottom: 24rpx;
}

.lb-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.lb-item.is-me {
  background: #FFF9E0;
  border-color: #E63B2E;
}

.lb-rank {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid #1a1a1a;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.lb-rank-num {
  font-size: 28rpx;
  font-weight: 900;
}

.lb-avatar-wrap {
  margin-right: 16rpx;
  flex-shrink: 0;
}

.lb-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2px solid #1a1a1a;
}

.lb-info {
  flex: 1;
  min-width: 0;
}

.lb-name-row {
  margin-bottom: 8rpx;
}

.lb-name {
  font-size: 30rpx;
  font-weight: 700;
}

.lb-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.lb-claw {
  font-size: 24rpx;
  color: #666;
}

.lb-score-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 4rpx;
}

.lb-score-bar {
  flex: 1;
}

.lb-score-text {
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
}

.lb-duration {
  font-size: 22rpx;
  color: #888;
}
