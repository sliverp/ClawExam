.page {
  padding-bottom: 16rpx;
}

.arena-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1b1b1b 0%, #1b1b1b 214rpx, #fff8e8 214rpx, #fff8e8 100%);
}

.arena-layout {
  min-height: 100vh;
  background: linear-gradient(180deg, #1b1b1b 0%, #1b1b1b 214rpx, #fff8e8 214rpx, #fff8e8 100%);
}

.arena-hero {
  padding: 34rpx 32rpx 28rpx;
  background: #1b1b1b;
}

.arena-hero-title {
  display: block;
  font-size: 54rpx;
  line-height: 1.2;
  font-weight: 900;
  color: #fff;
}

.arena-hero-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.42);
}

.arena-panel {
  margin: 0 18rpx 16rpx;
  padding: 22rpx 18rpx 18rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #fff6c8 0%, #fffdf5 100%);
  box-shadow: 0 14rpx 28rpx rgba(183, 146, 32, 0.12);
}

.arena-create-panel {
  margin-top: 10rpx;
}

.arena-panel-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.arena-panel-head-list {
  margin-bottom: 20rpx;
}

.arena-panel-title {
  position: relative;
  display: inline-block;
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 900;
  color: #18130d;
}

.arena-panel-title::after {
  content: '';
  position: absolute;
  left: 0;
  right: -8rpx;
  bottom: 0;
  height: 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(111, 224, 217, 0.76) 0%, rgba(255, 231, 125, 0.82) 48%, rgba(255, 175, 126, 0.76) 100%);
  z-index: -1;
}

.arena-panel-desc {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #b1924e;
  font-weight: 700;
}

.arena-create-options {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 0 64rpx;
}

.arena-create-option {
  height: 66rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 10rpx 20rpx rgba(226, 209, 156, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6c655f;
  font-size: 28rpx;
  font-weight: 800;
}

.arena-create-option.is-active {
  background: #000;
  color: #fff;
}

.arena-create-btn {
  width: 206rpx;
  height: 66rpx;
  margin: 24rpx auto 4rpx;
  padding: 0;
  border: none;
  border-radius: 18rpx;
  background: #000;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arena-create-btn::after {
  border: none;
}

.arena-create-btn[disabled] {
  opacity: 0.45;
}

.arena-room-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.arena-room-card {
  overflow: hidden;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 12rpx 22rpx rgba(222, 207, 160, 0.24);
}

.arena-room-v1 .arena-room-top {
  background: #d7f4ef;
}

.arena-room-v2 .arena-room-top {
  background: #dce6ff;
}

.arena-room-v3 .arena-room-top {
  background: #fbe0e3;
}

.arena-room-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 22rpx;
}

.arena-room-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.arena-room-title {
  min-width: 0;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 900;
  color: #2d2520;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.arena-room-version {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 38rpx;
  height: 28rpx;
  padding: 0 10rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.46);
  font-size: 22rpx;
  font-weight: 900;
}

.arena-room-status {
  flex-shrink: 0;
  min-width: 82rpx;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 16rpx;
  background: #ffc52f;
  color: #18120b;
  font-size: 22rpx;
  font-weight: 900;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.arena-room-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx 22rpx 20rpx;
}

.arena-room-meta {
  flex: 1;
  min-width: 0;
}

.arena-room-players {
  display: block;
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 900;
  color: #14110f;
}

.arena-room-time {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #c4bebb;
}

.arena-room-arrow {
  flex-shrink: 0;
  font-size: 42rpx;
  line-height: 1;
  font-weight: 300;
  color: #9f8340;
}

.arena-empty-list {
  padding: 54rpx 0 26rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b59a5b;
}

.loading-wrap {
  padding: 58rpx 0 44rpx;
  text-align: center;
}

.loading-text {
  font-size: 24rpx;
  color: #a89056;
}

.arena-empty {
  min-height: 100vh;
  padding: 120rpx 48rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: linear-gradient(180deg, #fff2bc 0%, #fff9eb 100%);
}

.arena-empty-icon {
  font-size: 88rpx;
}

.arena-empty-title {
  margin-top: 22rpx;
  font-size: 38rpx;
  font-weight: 900;
  color: #221f1b;
}

.arena-empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9a8c77;
}

.arena-login-btn {
  margin-top: 28rpx;
  width: 240rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 24rpx;
  border: none;
  background: #111;
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
}

.arena-login-btn::after {
  border: none;
}
