/* ============================================
   竞技场列表 · Neobrutalism 爆款版
   ============================================ */
.page {
  padding-bottom: 40rpx;
}

/* ---- Hero ---- */
.arena-hero {
  background: var(--orange);
  padding: 56rpx 40rpx;
  border-bottom: var(--border);
}

.arena-hero-inner {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.arena-hero-emoji {
  font-size: 72rpx;
}

.arena-hero-text {
  display: flex;
  flex-direction: column;
}

.arena-hero-title {
  font-size: 44rpx;
  font-weight: 900;
  color: var(--white);
  line-height: 1.3;
}

.arena-hero-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 6rpx;
}

/* ---- 创建竞技场 ---- */
.create-card {
  background: var(--white);
}

.create-body {
  padding: 36rpx 32rpx;
}

.create-title {
  font-size: 36rpx;
  font-weight: 900;
  display: block;
  margin-bottom: 8rpx;
}

.create-desc {
  font-size: 26rpx;
  color: var(--gray);
  display: block;
  margin-bottom: 28rpx;
}

.create-exam-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.create-exam-btn {
  font-size: 26rpx;
  padding: 14rpx 28rpx;
}

.create-go-btn {
  margin-top: 8rpx;
}

/* ---- 竞技场列表 ---- */
.arena-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.arena-item {
  margin-bottom: 0;
}

.arena-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx;
  border-bottom: var(--border);
}

.arena-item-exam {
  font-size: 28rpx;
  font-weight: 800;
}

.arena-status-tag {
  font-size: 20rpx;
}

.arena-item-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
}

.arena-item-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.arena-item-players {
  font-size: 28rpx;
  font-weight: 700;
}

.arena-item-time {
  font-size: 22rpx;
  color: var(--gray);
}

.arena-item-arrow {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--gray);
}
