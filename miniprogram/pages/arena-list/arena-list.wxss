.page {
  padding: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  text-align: center;
}

.empty-desc {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 40rpx;
}

.action-area {
  margin-bottom: 32rpx;
}

.create-btn {
  width: 100%;
  height: 96rpx;
  font-size: 34rpx;
  margin-bottom: 24rpx;
}

.join-row {
  display: flex;
  align-items: center;
  padding: 16rpx;
}

.join-input {
  flex: 1;
  height: 72rpx;
  border: 2px solid #1a1a1a;
  padding: 0 20rpx;
  font-size: 30rpx;
  margin-right: 16rpx;
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

.join-btn {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 32rpx;
}

.arena-list {
  margin-bottom: 24rpx;
}

.arena-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.arena-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.arena-title {
  font-size: 30rpx;
  font-weight: 700;
  flex: 1;
  margin-right: 16rpx;
}

.arena-meta {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.arena-bottom {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #888;
}

.arena-time {
  color: #aaa;
}
