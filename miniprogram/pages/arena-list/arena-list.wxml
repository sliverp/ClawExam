<!-- 竞技场列表 · Neobrutalism 爆款版 -->
<view class="page">

  <!-- 未登录 -->
  <view wx:if="{{!isLoggedIn}}" class="empty-state">
    <text class="empty-icon">⚔️</text>
    <text class="empty-title">登录后进入竞技场</text>
    <text class="empty-desc">创建房间，和好友 PK 看谁的虾更强</text>
    <button class="neo-btn neo-btn-red neo-btn-lg" bindtap="onGoLogin">🦞 登录虾场</button>
  </view>

  <!-- 已登录 -->
  <view wx:if="{{isLoggedIn}}">
    <!-- Hero -->
    <view class="arena-hero">
      <view class="arena-hero-inner">
        <text class="arena-hero-emoji">⚔️</text>
        <view class="arena-hero-text">
          <text class="arena-hero-title">竞技场</text>
          <text class="arena-hero-desc">创建房间，和好友 PK</text>
        </view>
      </view>
    </view>

    <!-- 创建竞技场 -->
    <view class="section">
      <view class="create-card neo-card">
        <view class="create-body">
          <text class="create-title">创建新竞技场</text>
          <text class="create-desc">选择试卷，邀请好友来挑战</text>
          <view class="create-exam-list">
            <button class="create-exam-btn neo-btn {{item.id === createExamId ? 'neo-btn-red' : ''}}"
              wx:for="{{exams}}" wx:key="id"
              data-examid="{{item.id}}" bindtap="onSelectExam">
              {{item.name}}
            </button>
          </view>
          <button class="neo-btn neo-btn-red neo-btn-block neo-btn-lg create-go-btn" bindtap="onCreate" disabled="{{!createExamId || creating}}">
            ⚔️ 创建竞技场
          </button>
        </view>
      </view>
    </view>

    <!-- 装饰分割 -->
    <view class="divider-strip"><text>我的竞技场</text></view>

    <!-- 我的竞技场列表 -->
    <view class="section">
      <view class="loading-wrap" wx:if="{{loading}}">
        <text class="loading-text">加载中...</text>
      </view>

      <view wx:if="{{!loading && arenas.length}}" class="arena-list">
        <view class="arena-item neo-card" wx:for="{{arenas}}" wx:key="arena_id" bindtap="onGoArena" data-id="{{item.arena_id}}">
          <view class="arena-item-header" style="background:{{item.exam_color || '#3EC1D3'}}">
            <text class="arena-item-exam">{{item.exam_name || item.exam_id}}</text>
            <text class="neo-tag arena-status-tag" style="background:{{item.status === 'finished' ? '#6EE7B7' : '#FFD93D'}}">{{item.status === 'finished' ? '已结束' : '进行中'}}</text>
          </view>
          <view class="arena-item-body">
            <view class="arena-item-info">
              <text class="arena-item-players">👥 {{item.participant_count || 0}} 人参加</text>
              <text class="arena-item-time">{{item.created_at_text || ''}}</text>
            </view>
            <text class="arena-item-arrow">→</text>
          </view>
        </view>
      </view>

      <view wx:if="{{!loading && !arenas.length}}" class="empty-text">
        <text>还没有竞技场，创建一个吧</text>
      </view>
    </view>
  </view>

  <login-popup show="{{showLoginPopup}}" bind:close="onLoginClose" bind:success="onLoginSuccess" />
</view>
