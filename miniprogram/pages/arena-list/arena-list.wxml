<view class="page arena-page">
  <view wx:if="{{!isLoggedIn}}" class="arena-empty">
    <text class="arena-empty-icon">⚔️</text>
    <text class="arena-empty-title">登录后进入竞技场</text>
    <text class="arena-empty-desc">创建房间，和好友 PK</text>
    <button class="arena-login-btn" bindtap="onGoLogin">立即登录</button>
  </view>

  <view wx:if="{{isLoggedIn}}" class="arena-layout">
    <view class="arena-hero">
      <text class="arena-hero-title">竞技场</text>
      <text class="arena-hero-desc">创建房间，和好友PK</text>
    </view>

    <view class="arena-panel arena-create-panel">
      <view class="arena-panel-head">
        <text class="arena-panel-title">创建新竞技场</text>
        <text class="arena-panel-desc">选择试卷，邀请好友来挑战</text>
      </view>

      <view class="arena-create-options">
        <view
          wx:for="{{exams}}"
          wx:key="id"
          class="arena-create-option {{createExamId === item.id ? 'is-active' : ''}}"
          data-examid="{{item.id}}"
          bindtap="onSelectExam"
        >
          {{item.name}}
        </view>
      </view>

      <button class="arena-create-btn" bindtap="onCreate" disabled="{{!createExamId || creating}}">
        {{creating ? '创建中...' : '创建竞技场'}}
      </button>
    </view>

    <view class="arena-panel">
      <view class="arena-panel-head arena-panel-head-list">
        <text class="arena-panel-title">我的竞技场</text>
      </view>

      <view class="loading-wrap" wx:if="{{loading}}">
        <text class="loading-text">加载中...</text>
      </view>

      <view wx:if="{{!loading && arenas.length}}" class="arena-room-list">
        <view class="arena-room-card arena-room-{{item.exam_id}}" wx:for="{{arenas}}" wx:key="id" bindtap="onGoArena" data-id="{{item.id}}">
          <view class="arena-room-top">
            <view class="arena-room-title-row">
              <text class="arena-room-title">{{item.exam_title}}</text>
              <text class="arena-room-version">{{item.exam_version}}</text>
            </view>
            <text class="arena-room-status">{{item.statusText}}</text>
          </view>

          <view class="arena-room-body">
            <view class="arena-room-meta">
              <text class="arena-room-players">{{item.participant_count || 0}}人参加</text>
              <text class="arena-room-time">{{item.created_at_text}}</text>
            </view>
            <text class="arena-room-arrow">→</text>
          </view>
        </view>
      </view>

      <view wx:if="{{!loading && !arenas.length}}" class="arena-empty-list">还没有竞技场，创建一个吧</view>
    </view>
  </view>

  <login-popup show="{{showLoginPopup}}" bind:close="onLoginClose" bind:success="onLoginSuccess" />
</view>
