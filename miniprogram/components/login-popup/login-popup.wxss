/* ============================================
   登录弹窗 · Neobrutalism 爆款版
   ============================================ */
.login-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
}

.popup-content {
  position: relative;
  width: 100%;
  background: #FFFBEB;
  border-top: 4px solid #1a1a1a;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
}

/* 顶部装饰条 */
.popup-strip {
  background: #1a1a1a;
  padding: 16rpx 0;
  text-align: center;
  color: #FFD93D;
  font-size: 22rpx;
  letter-spacing: 10rpx;
}

.popup-body {
  padding: 56rpx 48rpx;
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.popup-title {
  font-size: 52rpx;
  font-weight: 900;
  margin-bottom: 12rpx;
  color: #1a1a1a;
}

.popup-desc {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 48rpx;
}

.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  border: none;
  padding: 0;
  margin-bottom: 40rpx;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4px solid #1a1a1a;
  box-shadow: 5px 5px 0 #1a1a1a;
  background: #fff;
}

.avatar-tip {
  font-size: 24rpx;
  color: #888;
  margin-top: 16rpx;
  font-weight: 600;
}

.nickname-wrap {
  width: 100%;
  margin-bottom: 40rpx;
}

.nickname-label {
  font-size: 24rpx;
  font-weight: 800;
  color: #1a1a1a;
  display: block;
  margin-bottom: 12rpx;
}

.nickname-input {
  width: 100%;
  height: 100rpx;
  border: 3px solid #1a1a1a;
  padding: 0 28rpx;
  font-size: 32rpx;
  background: #fff;
  box-sizing: border-box;
  border-radius: 16rpx;
}

.confirm-btn {
  margin-bottom: 28rpx;
}

/* 隐私政策勾选 */
.privacy-wrap {
  width: 100%;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 32rpx;
}

.privacy-check {
  display: flex;
  align-items: center;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 3px solid #1a1a1a;
  border-radius: 6rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  font-size: 24rpx;
  font-weight: 900;
  color: #fff;
  flex-shrink: 0;
}

.checkbox.checked {
  background: #E63B2E;
  border-color: #1a1a1a;
}

.privacy-text {
  font-size: 24rpx;
  color: #666;
  font-weight: 600;
}

.privacy-link {
  font-size: 24rpx;
  color: #E63B2E;
  font-weight: 800;
  text-decoration: underline;
}

.skip-btn {
  font-size: 28rpx;
  color: #888;
  padding: 16rpx;
  font-weight: 600;
}

.privacy-notice-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.48);
  z-index: 5;
}

.privacy-notice-modal {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 6;
  padding: 36rpx 32rpx 30rpx;
  border-radius: 28rpx;
  background: #fffdf3;
  box-shadow: 0 24rpx 48rpx rgba(0, 0, 0, 0.18);
  display: flex;
  flex-direction: column;
}

.privacy-notice-title {
  font-size: 36rpx;
  line-height: 1.3;
  font-weight: 800;
  color: #1a1a1a;
  text-align: center;
}

.privacy-notice-desc {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5b544d;
}

.privacy-notice-card {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 243, 206, 0.76);
  box-shadow: inset 0 0 0 2rpx rgba(255, 214, 105, 0.35);
}

.privacy-notice-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #3d352f;
}

.privacy-notice-item {
  display: block;
  font-size: 22rpx;
  line-height: 1.7;
  color: #6b6158;
}

.privacy-notice-actions {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.privacy-notice-check {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
}

.privacy-checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 3px solid #1a1a1a;
  border-radius: 6rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  font-size: 24rpx;
  font-weight: 900;
  color: #fff;
  flex-shrink: 0;
}

.privacy-checkbox.checked {
  background: #E63B2E;
  border-color: #1a1a1a;
}

.privacy-check-text {
  font-size: 24rpx;
  color: #4f4740;
  font-weight: 600;
}

.privacy-notice-secondary,
.privacy-notice-primary {
  width: 100%;
  min-height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 700;
}

.privacy-notice-secondary {
  background: #fff;
  color: #1a1a1a;
  border: 3rpx solid #1a1a1a;
}

.privacy-notice-primary {
  border: none;
  background: linear-gradient(90deg, #ff7468 0%, #ffc440 100%);
  color: #fff;
}

.privacy-notice-primary::after {
  border: none;
}

.privacy-notice-close {
  margin-top: 18rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8b847d;
  padding: 8rpx 0;
}
