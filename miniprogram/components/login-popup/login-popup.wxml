<view class="login-popup" wx:if="{{show}}">
  <view class="mask" bindtap="onClose"></view>
  <view class="popup-content">
    <!-- 顶部装饰条 -->
    <view class="popup-strip">
      <text>🦞 · 🦞 · 🦞 · 🦞 · 🦞</text>
    </view>
    <view class="popup-body">
      <text class="popup-title">登录虾场</text>
      <text class="popup-desc">获取微信头像和昵称即可登录</text>

      <button open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" class="avatar-btn">
        <image
          src="{{avatarUrl || '/images/default-avatar.png'}}"
          class="avatar-img"
          mode="aspectFill"
        />
        <text class="avatar-tip">{{avatarUrl ? '点击更换头像' : '点击获取头像'}}</text>
      </button>

      <view class="nickname-wrap">
        <text class="nickname-label">昵称</text>
        <input
          type="nickname"
          class="nickname-input"
          placeholder="输入你的昵称"
          value="{{nickname}}"
          bindinput="onNicknameInput"
        />
      </view>

      <view class="privacy-wrap">
        <view class="privacy-check" bindtap="onTogglePrivacy">
          <view class="checkbox {{privacyAgreed ? 'checked' : ''}}">
            <text wx:if="{{privacyAgreed}}">✓</text>
          </view>
          <text class="privacy-text">登录前请先阅读并同意</text>
        </view>
        <text class="privacy-link" bindtap="onViewPrivacy">《隐私政策》</text>
      </view>

      <button
        class="confirm-btn neo-btn neo-btn-red neo-btn-block neo-btn-lg"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="onConfirm"
        loading="{{loading}}"
        disabled="{{loading}}"
      >
        确认登录
      </button>
      <text class="skip-btn" bindtap="onClose">暂不登录</text>
    </view>
  </view>

  <view class="privacy-notice-mask" wx:if="{{showPrivacyNotice}}" bindtap="onClosePrivacyNotice"></view>
  <view class="privacy-notice-modal" wx:if="{{showPrivacyNotice}}">
    <text class="privacy-notice-title">登录前请注意隐私授权</text>
    <text class="privacy-notice-desc">继续登录前，请先阅读《隐私政策》。登录时我们会获取你的头像、昵称，并保存你的考试记录、排行榜与竞技场数据。</text>

    <view class="privacy-notice-card">
      <text class="privacy-notice-label">你将授权我们用于：</text>
      <text class="privacy-notice-item">· 获取并保存你的昵称与头像</text>
      <text class="privacy-notice-item">· 同步你的考试成绩、排行榜和竞技场数据</text>
      <text class="privacy-notice-item">· 在“我的”页面查看历史记录与证书</text>
    </view>

    <view class="privacy-notice-check" bindtap="onTogglePrivacy">
      <view class="privacy-checkbox {{privacyAgreed ? 'checked' : ''}}">
        <text wx:if="{{privacyAgreed}}">✓</text>
      </view>
      <text class="privacy-check-text">我已阅读并同意《隐私政策》</text>
    </view>

    <view class="privacy-notice-actions">
      <view class="privacy-notice-secondary" bindtap="onViewPrivacy">查看隐私政策</view>
      <view class="privacy-notice-primary" bindtap="onClosePrivacyNotice">我已知晓</view>
    </view>

    <view class="privacy-notice-close" bindtap="onClose">暂不登录</view>
  </view>
</view>
