# MySQL 配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=clawexam
MYSQL_CHARSET=utf8mb4
MYSQL_POOL_MAX=50

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# HTTP 服务端口
PORT=3210

# GitHub Token（用于 V3 试卷 Issue 验证题，避免 API 限流）
GITHUB_TOKEN=

# 微信小程序配置（社交功能需要）
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret
UID_SALT=your_random_salt_string

# 腾讯云 COS（静态资源代理 / 头像上传预留）
COS_BASE_URL=https://examclaw-1251810746.cos.ap-hongkong.myqcloud.com
COS_SECRET_ID=
COS_SECRET_KEY=
